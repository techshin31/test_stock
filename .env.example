# Docker runtime configuration. Copy to .env and replace all placeholder values.
# .env is intentionally ignored by Git and must never be committed.
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-strong-unique-secret
POSTGRES_DB=quantpilot_db

# Bind services only to this machine unless remote access is explicitly required.
POSTGRES_HOST_BIND=127.0.0.1
API_HOST_BIND=127.0.0.1
DASHBOARD_HOST_BIND=127.0.0.1

# PAPER-only KOSPI200 1x inverse ETF hedge. These settings are ignored outside
# PAPER mode so they cannot activate an inverse strategy in REAL mode.
PAPER_INVERSE_HEDGE_ENABLED=true
HEDGE_MIN_CONFIRMATIONS=2
HEDGE_MIN_CONFIDENCE=0.6667
HEDGE_STAGE_ONE_WEIGHT=0.10
HEDGE_STAGE_TWO_WEIGHT=0.20
HEDGE_STAGE_THREE_WEIGHT=0.30
HEDGE_STOP_LOSS_PCT=0.05
HEDGE_MAX_HOLDING_SESSIONS=5
HEDGE_REENTRY_COOLDOWN_SESSIONS=3
