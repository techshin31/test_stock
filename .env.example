# Docker runtime configuration. Copy to .env and replace all placeholder values.
# .env is intentionally ignored by Git and must never be committed.
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-strong-unique-secret
POSTGRES_DB=quantpilot_db

# Bind services only to this machine unless remote access is explicitly required.
POSTGRES_HOST_BIND=127.0.0.1
API_HOST_BIND=127.0.0.1
DASHBOARD_HOST_BIND=127.0.0.1
